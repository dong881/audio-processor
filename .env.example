# Google Drive API (Service Account)
GOOGLE_SA_JSON_PATH=/app/credentials/service-account.json

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face Hub (for Pyannote)
HF_TOKEN=your_huggingface_token_here

# GitHub Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=username/repository-name
# Example: bmw-ece-ntust/ming-note
GITHUB_PATH=notes/Meeting-Minutes
# Example path where meeting minutes will be stored
GITHUB_BRANCH=main
# Optional: default is 'main'
GITHUB_FILENAME_TEMPLATE=MM-YYYYMMDD.md
# Template for filename. YYYYMMDD will be replaced with current date

# Flask Settings
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=your_secret_key_here_change_in_production

# Redis (for job queue - optional, using docker-compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
