# Flask 設定
PORT=5000
FLASK_DEBUG=false
FLASK_SECRET_KEY=your_secret_key_here

# Google API 設定
USE_SERVICE_ACCOUNT=true
GOOGLE_SA_JSON_PATH=/app/credentials/service-account.json
GOOGLE_CLIENT_SECRET_PATH=/app/credentials/client_secret.json
# 或者使用 OAuth (二選一)
# USE_SERVICE_ACCOUNT=false
# GOOGLE_CREDS_JSON_PATH=/app/credentials/oauth-credentials.json

# OAuth 設定
# EXTERNAL_URL=https://your-domain.com

# Gemini API 設定
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face 設定 (用於 pyannote.audio)
HF_TOKEN=your_huggingface_token

# Notion API 設定
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Redis 設定
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0